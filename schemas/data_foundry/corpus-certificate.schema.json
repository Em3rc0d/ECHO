{
  "$id": "https://github.com/Em3rc0d/ECHO/schemas/data_foundry/corpus-certificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECHO MK1 Corpus Certificate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_version",
    "status",
    "scope",
    "semantic_evidence_identity_sha256",
    "semantic_evidence_identity_material",
    "handoff_authority",
    "free_tier_boundary",
    "inputs",
    "empirical_outputs",
    "outputs",
    "criteria",
    "issuance_provenance",
    "evidence",
    "non_claims",
    "invalidates_if",
    "hash_contract",
    "certificate_sha256"
  ],
  "properties": {
    "schema_version": {"const": "echo.corpus-certificate.v2"},
    "artifact_id": {"const": "CERT-MK1-DF-CORPUS-001"},
    "artifact_version": {"const": "1.0.0"},
    "status": {"const": "CERTIFIED"},
    "scope": {"type": "string", "minLength": 1},
    "semantic_evidence_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_evidence_identity_material": {"type": "object"},
    "handoff_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate", "path", "sha256", "status"],
      "properties": {
        "certificate": {"const": "CERT-MK1-DF-HANDOFF-001"},
        "path": {"const": "MK1/build/data-foundry/CORPUS-CERTIFICATE-HANDOFF.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "CERTIFIED"}
      }
    },
    "free_tier_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "path", "policy_sha256", "result"],
      "properties": {
        "policy_id": {"const": "ECHO-FREE-TIER-001"},
        "path": {"const": "configs/data_foundry/free_tier_boundary.v1.json"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result": {"const": "PASS"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolchain_certificate", "corpus_readiness", "canonical_ledger_summary", "coverage_policy"],
      "properties": {
        "toolchain_certificate": {
          "type": "object",
          "required": ["id", "path", "sha256", "status"],
          "properties": {
            "id": {"const": "CERT-MK1-DF-TOOLCHAIN-005"},
            "path": {"const": "MK1/test/DATA-FOUNDRY-TOOLCHAIN-RECERTIFICATION-005.md"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"const": "CERTIFIED"}
          },
          "additionalProperties": false
        },
        "corpus_readiness": {"type": "object"},
        "canonical_ledger_summary": {"type": "object"},
        "coverage_policy": {"type": "object"}
      }
    },
    "empirical_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["EMP-DATASET-001", "EMP-DATA-QUALITY-001"],
      "properties": {
        "EMP-DATASET-001": {"$ref": "#/$defs/empiricalOutput"},
        "EMP-DATA-QUALITY-001": {"$ref": "#/$defs/empiricalOutput"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {"path": {"const": "MK1/mining-site/materialization/cert-mk1-df-corpus-001.json"}},
        "additionalProperties": false
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"const": "PASS"}
        },
        "additionalProperties": false
      }
    },
    "issuance_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_commit", "generated_at_utc", "github_run_id", "note"],
      "properties": {
        "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generated_at_utc": {"type": "string", "minLength": 1},
        "github_run_id": {"type": ["string", "null"]},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"const": "PASS"}
        },
        "additionalProperties": false
      }
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invalidates_if": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hash_contract": {"type": "string", "minLength": 1},
    "certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "empiricalOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "basis", "claim"],
      "properties": {
        "status": {"const": "PASS"},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "claim": {"type": "string", "minLength": 1}
      }
    }
  }
}
