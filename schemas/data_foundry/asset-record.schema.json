{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/data-foundry/asset-record.v1.json",
  "title": "ECHO Data Foundry Asset Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "source_dataset",
    "source_release",
    "source_asset_id",
    "sha256",
    "license_id",
    "use_decision",
    "original_labels",
    "echo_labels",
    "mapping_status",
    "recording_group_id",
    "field_holdout",
    "admission_status",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "echo.asset-record.v1"},
    "asset_id": {"type": "string", "minLength": 1},
    "source_dataset": {"type": "string", "minLength": 1},
    "source_release": {"type": "string", "minLength": 1},
    "source_asset_id": {"type": "string", "minLength": 1},
    "origin_uri": {"type": ["string", "null"]},
    "local_relpath": {"type": ["string", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": ["integer", "null"], "minimum": 0},
    "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "sample_rate_hz": {"type": ["integer", "null"], "minimum": 1},
    "channels": {"type": ["integer", "null"], "minimum": 1},
    "license_id": {"type": "string", "minLength": 1},
    "use_decision": {"enum": ["ALLOW_RELEASE_SAFE", "ALLOW_RESEARCH_ONLY", "RESEARCH_ONLY", "REVIEW_REQUIRED", "QUARANTINE", "DENY"]},
    "original_labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "echo_labels": {"type": "array", "items": {"enum": ["GLASS_SHATTER", "SIREN", "FIRE_ALARM", "VEHICLE_HORN", "TIRE_SQUEAL"]}, "uniqueItems": true},
    "mapping_status": {"enum": ["EXACT", "NARROWER", "BROADER", "AMBIGUOUS", "NEGATIVE", "UNUSABLE", "MIXED"]},
    "label_provenance": {"type": ["string", "null"]},
    "recording_group_id": {"type": "string", "minLength": 1},
    "uploader_or_source_id": {"type": ["string", "null"]},
    "site_id": {"type": ["string", "null"]},
    "device_id": {"type": ["string", "null"]},
    "original_split": {"type": ["string", "null"]},
    "echo_split": {"type": ["string", "null"], "enum": ["train", "validation", "test", "field_holdout", null]},
    "field_holdout": {"type": "boolean"},
    "admission_status": {"enum": ["DISCOVERED", "STAGED", "ADMITTED_RELEASE_SAFE", "ADMITTED_RESEARCH_ONLY", "ADMITTED_FIELD_HOLDOUT", "QUARANTINED", "REJECTED"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parent_asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "extra": {"type": "object"}
  }
}
