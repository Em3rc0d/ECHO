{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/data-foundry/coverage-policy.v1.json",
  "title": "ECHO Data Foundry Coverage Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "profiles", "governance"],
  "properties": {
    "schema_version": {"const": "echo.coverage-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["target_labels", "per_split", "max_single_source_fraction_per_class", "background", "hard_negatives", "asset_quality"],
        "properties": {
          "target_labels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["min_assets", "min_independent_groups", "min_sources", "min_clip_duration_seconds"],
              "properties": {
                "min_assets": {"type": "integer", "minimum": 0},
                "min_independent_groups": {"type": "integer", "minimum": 0},
                "min_sources": {"type": "integer", "minimum": 0},
                "min_clip_duration_seconds": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "per_split": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["min_assets_per_class", "min_groups_per_class"],
              "properties": {
                "min_assets_per_class": {"type": "integer", "minimum": 0},
                "min_groups_per_class": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "max_single_source_fraction_per_class": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "background": {
            "type": "object",
            "required": ["min_assets", "min_independent_groups", "min_sources"],
            "properties": {
              "min_assets": {"type": "integer", "minimum": 0},
              "min_independent_groups": {"type": "integer", "minimum": 0},
              "min_sources": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "hard_negatives": {
            "type": "object",
            "required": ["per_target"],
            "properties": {
              "per_target": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": ["min_assets", "min_independent_groups", "min_sources"],
                  "properties": {
                    "min_assets": {"type": "integer", "minimum": 0},
                    "min_independent_groups": {"type": "integer", "minimum": 0},
                    "min_sources": {"type": "integer", "minimum": 0}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "asset_quality": {
            "type": "object",
            "required": ["require_audio_probe_ok", "require_positive_duration", "require_known_license", "require_label_provenance", "max_exact_duplicate_groups", "max_near_duplicate_groups"],
            "properties": {
              "require_audio_probe_ok": {"type": "boolean"},
              "require_positive_duration": {"type": "boolean"},
              "require_known_license": {"type": "boolean"},
              "require_label_provenance": {"type": "boolean"},
              "max_exact_duplicate_groups": {"type": "integer", "minimum": 0},
              "max_near_duplicate_groups": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  }
}
