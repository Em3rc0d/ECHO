{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/data-foundry/publisher-snapshot.v1.json",
  "title": "ECHO Publisher Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_id", "record_id", "record_url", "doi", "release",
    "dataset_license", "license_model", "captured_at", "publisher", "evidence_scope",
    "source_url", "files", "license_evidence"
  ],
  "properties": {
    "schema_version": {"const": "echo.publisher-snapshot.v1"},
    "source_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_url": {"type": "string", "minLength": 1},
    "doi": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "dataset_license": {"type": "string", "minLength": 1},
    "license_model": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "format": "date"},
    "publisher": {"type": "string", "minLength": 1},
    "evidence_scope": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "md5", "size_display"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "size_display": {"type": "string", "minLength": 1}
        }
      }
    },
    "license_evidence": {"type": "object"}
  }
}
