{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echo.local/schemas/data-foundry/source-registry.v1.json",
  "title": "ECHO Data Foundry Source Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_checked_at", "sources"],
  "properties": {
    "schema_version": {"const": "echo.source-registry.v1"},
    "evidence_checked_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "name", "release", "role", "license_model", "default_profile", "target_coverage"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "release": {"type": "string", "minLength": 1},
          "canonical_url": {"type": ["string", "null"]},
          "companion_url": {"type": ["string", "null"]},
          "role": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "license_model": {"type": "string", "minLength": 1},
          "dataset_license": {"type": ["string", "null"]},
          "default_profile": {"type": "string", "minLength": 1},
          "asset_license_required": {"type": "boolean"},
          "raw_media_auto_ingest": {"type": "boolean"},
          "external_gate": {"type": "string"},
          "target_coverage": {"type": "object"},
          "group_keys": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  }
}
