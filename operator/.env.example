# Copy to operator/.env; never commit secrets. Paths below are relative to repository root.
PGPASSWORD_PATH=./operator/secrets/postgres_password
BOOTSTRAP_PASSWORD_PATH=./operator/secrets/bootstrap_password
VAPID_PUBLIC_KEY_PATH=./operator/secrets/vapid_public_key
VAPID_PRIVATE_KEY_PATH=./operator/secrets/vapid_private_key
PUBLIC_ORIGIN=http://localhost:8090
OPERATOR_MODE=development
ENABLE_LAB_PUSH=false
BOOTSTRAP_USER=admin
VAPID_SUBJECT=mailto:operator@example.invalid
# Optional production config only; does not provision or deploy a VPS.
OPERATOR_DOMAIN=echo.example.invalid
WORKER_MEMORY_LIMIT=6g
